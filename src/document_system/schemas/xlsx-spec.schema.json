{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.local/schemas/xlsx-spec.schema.json",
  "title": "Declarative XLSX workbook specification",
  "type": "object",
  "required": ["sheets"],
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "subject": {"type": "string"},
        "creator": {"type": "string"},
        "keywords": {"type": "string"},
        "category": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "primary": {"$ref": "#/$defs/color"},
        "secondary": {"$ref": "#/$defs/color"},
        "accent": {"$ref": "#/$defs/color"},
        "positive": {"$ref": "#/$defs/color"},
        "negative": {"$ref": "#/$defs/color"},
        "text": {"$ref": "#/$defs/color"},
        "muted": {"$ref": "#/$defs/color"},
        "light": {"$ref": "#/$defs/color"},
        "font": {"type": "string"}
      },
      "additionalProperties": false
    },
    "active_sheet": {"type": "string"},
    "sheets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sheet"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "color": {"type": "string", "pattern": "^[0-9A-Fa-f]{6}$"},
    "cell-value": {"type": ["string", "number", "integer", "boolean", "null"]},
    "cell-style": {
      "type": "object",
      "properties": {
        "style": {"enum": ["title", "subtitle", "section", "header", "input", "formula", "text", "integer", "decimal", "currency", "percent", "date", "note", "positive", "negative"]},
        "number_format": {"type": "string"},
        "font_color": {"$ref": "#/$defs/color"},
        "fill": {"$ref": "#/$defs/color"},
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"},
        "font_size": {"type": "number", "minimum": 6, "maximum": 72},
        "align": {"enum": ["left", "center", "right"]},
        "vertical": {"enum": ["top", "center", "bottom"]},
        "wrap": {"type": "boolean"},
        "locked": {"type": "boolean"}
      }
    },
    "cell": {
      "type": "object",
      "required": ["cell"],
      "properties": {
        "cell": {"type": "string", "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"},
        "value": {"$ref": "#/$defs/cell-value"},
        "formula": {"type": "string", "minLength": 2},
        "comment": {"type": "string"},
        "comment_author": {"type": "string"},
        "hyperlink": {"type": "string"}
      },
      "allOf": [{"$ref": "#/$defs/cell-style"}],
      "unevaluatedProperties": false
    },
    "column": {
      "type": "object",
      "required": ["column"],
      "properties": {
        "column": {"type": "string", "pattern": "^[A-Za-z]{1,3}$"},
        "width": {"type": "number", "minimum": 1, "maximum": 100},
        "hidden": {"type": "boolean"},
        "outline_level": {"type": "integer", "minimum": 0, "maximum": 7}
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["row"],
      "properties": {
        "row": {"type": "integer", "minimum": 1},
        "height": {"type": "number", "minimum": 1, "maximum": 409},
        "hidden": {"type": "boolean"},
        "outline_level": {"type": "integer", "minimum": 0, "maximum": 7}
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": ["name", "start_cell", "headers", "rows"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"},
        "start_cell": {"type": "string", "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"},
        "headers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rows": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/cell-value"}}},
        "style": {"type": "string"},
        "totals_row": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "chart": {
      "type": "object",
      "required": ["type", "data_range", "anchor"],
      "properties": {
        "type": {"enum": ["bar", "column", "line", "pie", "area"]},
        "title": {"type": "string"},
        "data_sheet": {"type": "string"},
        "data_range": {"type": "string"},
        "categories_range": {"type": "string"},
        "anchor": {"type": "string", "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"},
        "series_from": {"enum": ["columns", "rows"]},
        "titles_from_data": {"type": "boolean"},
        "x_title": {"type": "string"},
        "y_title": {"type": "string"},
        "style": {"type": "integer", "minimum": 1, "maximum": 48},
        "width": {"type": "number", "minimum": 3, "maximum": 40},
        "height": {"type": "number", "minimum": 2, "maximum": 30},
        "legend": {"enum": ["top", "bottom", "left", "right", "none"]}
      },
      "additionalProperties": false
    },
    "conditional-format": {
      "type": "object",
      "required": ["range", "type"],
      "properties": {
        "range": {"type": "string"},
        "type": {"enum": ["color_scale", "data_bar", "cell"]},
        "min_color": {"$ref": "#/$defs/color"},
        "mid_color": {"$ref": "#/$defs/color"},
        "max_color": {"$ref": "#/$defs/color"},
        "color": {"$ref": "#/$defs/color"},
        "operator": {"type": "string"},
        "formula": {"type": "array", "items": {"type": "string"}},
        "fill": {"$ref": "#/$defs/color"},
        "font_color": {"$ref": "#/$defs/color"}
      },
      "additionalProperties": false
    },
    "data-validation": {
      "type": "object",
      "required": ["range", "type", "formula1"],
      "properties": {
        "range": {"type": "string"},
        "type": {"enum": ["list", "whole", "decimal", "date", "textLength", "custom"]},
        "operator": {"type": "string"},
        "formula1": {"type": "string"},
        "formula2": {"type": "string"},
        "allow_blank": {"type": "boolean"},
        "prompt_title": {"type": "string"},
        "prompt": {"type": "string"},
        "error_title": {"type": "string"},
        "error": {"type": "string"}
      },
      "additionalProperties": false
    },
    "sheet": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 31},
        "state": {"enum": ["visible", "hidden", "veryHidden"]},
        "tab_color": {"$ref": "#/$defs/color"},
        "freeze_panes": {"type": "string"},
        "show_gridlines": {"type": "boolean"},
        "zoom": {"type": "integer", "minimum": 10, "maximum": 400},
        "auto_filter": {"type": "string"},
        "merge_cells": {"type": "array", "items": {"type": "string"}},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/column"}},
        "rows": {"type": "array", "items": {"$ref": "#/$defs/row"}},
        "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}},
        "tables": {"type": "array", "items": {"$ref": "#/$defs/table"}},
        "charts": {"type": "array", "items": {"$ref": "#/$defs/chart"}},
        "conditional_formats": {"type": "array", "items": {"$ref": "#/$defs/conditional-format"}},
        "data_validations": {"type": "array", "items": {"$ref": "#/$defs/data-validation"}},
        "print": {
          "type": "object",
          "properties": {
            "orientation": {"enum": ["portrait", "landscape"]},
            "paper_size": {"enum": ["A4", "Letter"]},
            "fit_to_width": {"type": "integer", "minimum": 0, "maximum": 20},
            "fit_to_height": {"type": "integer", "minimum": 0, "maximum": 100},
            "repeat_rows": {"type": "string"},
            "repeat_columns": {"type": "string"},
            "print_area": {"type": "string"},
            "headers_footers": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
