{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workspace.local/schemas/xlsx-edit-plan.schema.json",
  "title": "XLSX cell edit plan",
  "type": "object",
  "required": ["updates"],
  "properties": {
    "updates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sheet", "cell"],
        "properties": {
          "sheet": {"type": "string", "minLength": 1},
          "cell": {"type": "string", "pattern": "^[A-Za-z]{1,3}[1-9][0-9]*$"},
          "value": {"type": ["string", "number", "integer", "boolean", "null"]},
          "formula": {"type": "string", "minLength": 2},
          "cached_value": {"type": ["string", "number", "integer", "boolean", "null"]},
          "expected": {"type": ["string", "number", "integer", "boolean", "null"]}
        },
        "oneOf": [
          {"required": ["value"]},
          {"required": ["formula"]}
        ],
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "subject": {"type": "string"},
        "creator": {"type": "string"},
        "keywords": {"type": "string"},
        "category": {"type": "string"},
        "description": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
