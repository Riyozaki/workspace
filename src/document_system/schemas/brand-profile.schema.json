{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "theme": {
      "type": "object",
      "properties": {
        "primary": {"type": "string"},
        "secondary": {"type": "string"},
        "accent": {"type": "string"},
        "background": {"type": "string"},
        "light": {"type": "string"},
        "text": {"type": "string"},
        "muted": {"type": "string"},
        "positive": {"type": "string"},
        "negative": {"type": "string"},
        "font": {"type": "string"},
        "heading_font": {"type": "string"}
      },
      "additionalProperties": false
    },
    "formats": {
      "type": "object",
      "properties": {
        "docx": {"type": "object"},
        "xlsx": {"type": "object"},
        "pptx": {"type": "object"},
        "pdf": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
